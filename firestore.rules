rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Données de progression de l'utilisateur (niveaux, habitudes, journal, bibliothèque...)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Abonnement : l'utilisateur peut lire le sien, mais ne peut jamais s'auto-activer.
    // Seules les routes API serveur (via Firebase Admin SDK, qui contourne ces règles
    // après vérification réelle auprès de PayPal/Stripe) peuvent écrire status = "active".
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Préférences de rappels + abonnement push : l'utilisateur gère librement les siens
    // (aucune donnée sensible ici, juste ses propres préférences de notification).
    match /push_subscriptions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Catalogue de livres ajoutés depuis le panneau d'administration : lecture publique,
    // écriture réservée à l'administrateur (identifié par son email).
    match /library_catalog/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "yonu.islam@gmail.com";
    }

    // Suivi des fichiers PDF envoyés (Firebase Storage) pour chaque livre — le contenu
    // réel n'est jamais accessible directement, seul le chemin de stockage est indiqué ici.
    match /book_files/{bookId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "yonu.islam@gmail.com";
    }

    // Surlignages PDF : un document par (utilisateur, livre), jamais accessible à quelqu'un d'autre.
    match /highlights/{id} {
      allow read: if request.auth != null && id.split('_')[0] == request.auth.uid;
      allow create, update: if request.auth != null
        && id.split('_')[0] == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
