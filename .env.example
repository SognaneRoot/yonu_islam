# ============================================================================
# Mon Chemin vers Allah — modèle de variables d'environnement
# Copie ce fichier en .env.local (local) et reporte les mêmes valeurs dans
# Vercel > Project Settings > Environment Variables (production).
# Ne commite JAMAIS un fichier contenant de vraies valeurs (.env.local est
# déjà ignoré par Git).
# ============================================================================

# ---- Firebase (comptes + base de données) — obligatoire pour comptes/abonnements ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# JSON complet du compte de service (Paramètres du projet > Comptes de service > Générer une nouvelle clé privée), sur une seule ligne
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- PayPal (abonnements récurrents) — optionnel tant que non prêt ----
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_ANNUAL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---- Stripe (carte bancaire) — optionnel tant que non prêt ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://ton-domaine.vercel.app

# ---- Verrouillage premium ----
# Laisse vide/absent tant que PayPal/Stripe ne sont pas prêts : tout reste gratuit.
# Mets "true" une fois les paiements actifs pour activer le verrouillage réel.
NEXT_PUBLIC_PREMIUM_ENFORCEMENT=

# ---- Rappels push (Fajr, Adhkar, Coran) — optionnel ----
# Génère la paire avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@example.com
# Chaîne aléatoire longue que tu inventes toi-même, pour protéger la route cron
CRON_SECRET=

# ---- Vercel Blob (stockage des PDF, via /escanor) ----
# Ajoutée AUTOMATIQUEMENT par Vercel quand tu crées un store Blob (Storage > Create Database > Blob)
# — ne pas la remplir toi-même, juste vérifier qu'elle existe après avoir créé le store.
BLOB_READ_WRITE_TOKEN=

# ---- Emails transactionnels (Resend) — optionnel ----
# Confirmation d'abonnement envoyée après un paiement PayPal/Stripe réussi.
# La confirmation d'inscription (vérification d'email) utilise Firebase Auth
# directement et ne nécessite PAS Resend.
# Crée un compte gratuit sur https://resend.com puis vérifie ton domaine d'envoi.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mon Chemin vers Allah <contact@ton-domaine.com>
